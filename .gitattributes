# A .pfr carries an FNV-1a over its own raw disk bytes (append_file_hash(),
# src/replay.c), and a mismatch refuses the file rather than replaying
# something nobody recorded.  End-of-line conversion would change those bytes
# and break every committed vector on checkout, so these are handled verbatim.
tests/golden/*.pfr -text

# The suite scripts run under sh, so a CRLF checkout on Windows would put a
# carriage return in the shebang and every command line. Pin them to LF.
tests/golden/*.sh text eol=lf

# Generated and read by tests/golden/run.sh with awk. core.autocrlf is true
# in this repository, and a CRLF checkout would put a carriage return on the
# end of every extracted value.
tests/golden/*.expected text eol=lf

# Shipped in the Linux release tarball and run by sh; a CRLF checkout on
# Windows would break it the same way as the suite scripts above.
res/linux/*.sh text eol=lf
