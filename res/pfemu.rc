#include <windows.h>
#include "resource.h"

IDI_PFEMU ICON "res/pfemu.ico"

VS_VERSION_INFO VERSIONINFO
 FILEVERSION 1,0,0,0
 PRODUCTVERSION 1,0,0,0
 FILEFLAGSMASK 0x3fL
 FILEFLAGS 0x0L
 FILEOS 0x40004L
 FILETYPE 0x1L
 FILESUBTYPE 0x0L
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "pfemu - Pinball Fantasies emulator"
            VALUE "FileVersion", "1.0"
            VALUE "InternalName", "pfemu"
            VALUE "OriginalFilename", "pfemu.exe"
            VALUE "ProductName", "pfemu"
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
